# Chave usada para assinar o cookie de sessão. Obrigatória em produção.
# Gere uma com: openssl rand -hex 32
AUTH_SECRET=

# Opcional: Redis para o rate limiting. Sem ele, o limite é guardado em memória.
REDIS_URL=

# Banco de dados Postgres usado pelo Prisma (obrigatório).
# Em desenvolvimento, `npx prisma dev --detach` (dentro de apps/web) sobe um Postgres
# local e imprime a URL TCP (postgres://...) para colar aqui. Também funciona Docker
# ou um Postgres instalado, por exemplo:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vysesystem
DATABASE_URL=