# Chave usada para assinar o cookie de sessão. Obrigatória em produção.
# Gere uma com: openssl rand -hex 32
AUTH_SECRET=

# Opcional: Redis para o rate limiting. Sem ele, o limite é guardado em memória.
REDIS_URL=

# Banco de dados. Com DATABASE_URL o app usa esse Postgres (obrigatório em produção).
# Sem ela, usa um Postgres embutido (PGlite) salvo em apps/web/data/pglite,
# criado e populado com dados de demonstração na primeira requisição.
DATABASE_URL=

# Opcional: outra pasta para o PGlite, ou "memory://" para um banco descartável em memória
PGLITE_DATA_DIR=