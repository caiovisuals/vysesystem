# Chave usada para assinar o cookie de sessão. Obrigatória em produção.
# Gere uma com: openssl rand -hex 32
AUTH_SECRET=

# Opcional: Redis para o rate limiting. Sem ele, o limite é guardado em memória.
REDIS_URL=

# Banco de dados Postgres usado pelo Prisma (obrigatório).
# Em desenvolvimento, `npx prisma dev --detach` (dentro de apps/web) sobe um Postgres
# local e imprime a URL TCP (postgres://...) para colar aqui. Também funciona Docker
# ou um Postgres instalado, por exemplo:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vysesystem
DATABASE_URL=

# URL pública do app, usada nos links enviados por e-mail (ex.: recuperação de senha).
# Obrigatória em produção; em desenvolvimento usa a origem da requisição.
# APP_URL=https://vysesystem.exemplo.com.br
APP_URL=

# Envio de e-mails (recuperação de senha) pelo Resend: https://resend.com
# Crie a chave em https://resend.com/api-keys e use um remetente de um domínio verificado.
# Sem as duas, em desenvolvimento o link aparece no terminal; em produção nada é enviado.
RESEND_API_KEY=

# MAIL_FROM="VyseSystem <nao-responda@seudominio.com.br>"
MAIL_FROM=no-reply@vysesystem.com