{
  "name": "vysesystem",
  "version": "0.1.0",
  "private": true,
  "description": "PDV (Ponto de Venda) — monorepo com apps web (Next.js) e mobile (Expo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=vysesystem-web",
    "dev:web": "npm run dev --workspace=vysesystem-web",
    "dev:mobile": "npm run start --workspace=vysesystem-mobile",
    "build": "npm run build --workspace=vysesystem-web",
    "start": "npm run start --workspace=vysesystem-web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck"
  }
}