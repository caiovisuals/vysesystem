{
  "name": "vysesystem",
  "version": "0.1.0",
  "private": true,
  "description": "PDV (Ponto de Venda): monorepo com apps web (Next.js), desktop (Electron) e mobile (Expo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=vysesystem-web",
    "dev:web": "npm run dev --workspace=vysesystem-web",
    "dev:mobile": "npm run start --workspace=vysesystem-app",
    "dev:desktop": "npm run dev --workspace=vysesystem-desktop",
    "build": "npm run build --workspace=vysesystem-web",
    "build:desktop": "npm run build --workspace=vysesystem-desktop",
    "dist:desktop": "npm run dist --workspace=vysesystem-desktop",
    "start": "npm run start --workspace=vysesystem-web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=vysesystem-web",
    "check": "npm run lint && npm run typecheck && npm run test"
  }
}